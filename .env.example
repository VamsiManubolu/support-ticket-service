# Copy to .env and adjust. docker compose reads .env automatically; every value has a default.

# local | test | production (production switches logs to JSON)
APP_ENV=local
LOG_LEVEL=INFO

# Postgres container credentials; DATABASE_URL below is built from them in docker-compose.yml
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets

# Used when running the app outside Docker (inside Docker, compose sets the db host)
DATABASE_URL=postgresql+psycopg://tickets:tickets@localhost:5432/tickets
REDIS_URL=redis://localhost:6379/0

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

SEED_ON_START=true

# Browser origins allowed to call the API (comma-separated). Leave empty when a reverse
# proxy handles CORS or serves the frontend on the same origin.
CORS_ORIGINS=

# Background processing
# Worker threads = max tickets analyzed at once (I/O-bound, e.g. LLM calls)
WORKER_CONCURRENCY=16
# Per-analysis timeout; a timeout is retried with backoff (max 3 retries)
PROCESSING_TIMEOUT_SECONDS=30
# Fake network latency for the keyword analyzer, to demo concurrency (0 = off)
PROCESSING_SIMULATED_LATENCY_MS=0
